      "footnotes": [
        {
          "marker": "*",
          "text": "Days -15 through -9 are allotted for washout of cocaine after admission.  Subjects’ urine will be tested daily to document when it becomes negative for cocaine.",
          "continuedAcrossPages": false,
          "appliesTo": [
            {
              "target": "column",
              "col": "c2"
            }
          ]
        },
        {
          "marker": "**",
          "text": "Blood chemistries, including liver function tests, will be performed at outpatient and inpatient screening, on days 6 and 13, at discharge (day 17) and at follow-up (day 31).",
          "continuedAcrossPages": false,
          "appliesTo": [
            {
              "target": "row",
              "row": "r12"
            }
          ]
        },
        {
          "marker": "***",
          "text": "Pregnancy test at intake screening should be done within 72 hours before the first screening cocaine infusion.",
          "continuedAcrossPages": false,
          "appliesTo": [
            {
              "target": "row",
              "row": "r14"
            }
          ]
        },
        {
          "marker": "****",
          "text": "Cognitive assessments will be performed on day -7 and on day 11.",
          "continuedAcrossPages": false,
          "appliesTo": [
            {
              "target": "row",
              "row": "r19"
            }
          ]
        },
        {
          "marker": "Xa",
          "text": "POMS, BSCS will be performed at intake and then every other day.",
          "continuedAcrossPages": false,
          "appliesTo": [
            {
              "target": "cell",
              "row": "r18",
              "col": "c2"
            }
          ]
        },
        {
          "marker": "Xb",
          "text": "atomoxetine will be administered at 20 mg q.d. on days 0 and 1, 40 mg q.d. on days 2 and 3, 80 mg q.d. on days 4-8 and 100 mg q.d. on days 9-13.",
          "continuedAcrossPages": false,
          "appliesTo": [
            {
              "target": "cell",
              "row": "r20",
              "col": "c6"
            }
          ]
        },
        {
          "marker": "Xc",
          "text": "VAS will be performed on days -10, -9, and on all infusion days.",
          "continuedAcrossPages": false,
          "appliesTo": [
            {
              "target": "cell",
              "row": "r27",
              "col": "c2"
            }
          ]
        },
        {
          "marker": "Xd",
          "text": "ARCI  will be performed on days -10, -9, and on all non-infusion days.",
          "continuedAcrossPages": false,
          "appliesTo": [
            {
              "target": "cell",
              "row": "r28",
              "col": "c2"
            }
          ]
        },
        {
          "marker": "Xe",
          "text": "BPRS will be administered on baseline, every day during treatment with atomoxetine and on the days of all cocaine infusions.",
          "continuedAcrossPages": false,
          "appliesTo": [
            {
              "target": "cell",
              "row": "r30",
              "col": "c2"
            }
          ]
        },
        {
          "marker": "Xf",
          "text": "atomoxetine blood levels will be determined on days 6, 8, 11 and 13.",
          "continuedAcrossPages": false,
          "appliesTo": [
            {
              "target": "cell",
              "row": "r21",
              "col": "c7"
            }
          ]
        }
      ],
